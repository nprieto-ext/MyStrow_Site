Options -Indexes

# -------------------------------------------------------
# HTTPS + www → non-www
# -------------------------------------------------------
RewriteEngine On

# Redirect old slugs
RewriteRule ^programmation-dmx-avec-mystrow(/.*)?$ /programmation-lumiere [R=301,L]
RewriteRule ^synchroniser-mystrow-platine-dj(/.*)?$ /synchroniser-mystrow-logiciel-dj [R=301,L]

# HTTP → HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# www → non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# -------------------------------------------------------
# .html → URL propre (301, une seule URL indexable par page)
# -------------------------------------------------------
# On teste THE_REQUEST (la requete d'origine du navigateur) et non l'URL
# courante : les reecritures internes plus bas ne le modifient pas, donc
# aucune boucle de redirection possible.

# /chemin/index.html → /chemin/
RewriteCond %{THE_REQUEST} \s/+([^?\s]*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page.html → /page
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# -------------------------------------------------------
# Clean URLs : retire l'extension .html
# -------------------------------------------------------

# Si le fichier existe tel quel, on le sert directement
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Si le répertoire existe, on le sert directement
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Sinon : essaie d'ajouter .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# -------------------------------------------------------
# Types MIME des medias
# -------------------------------------------------------
# Sans ces declarations, LiteSpeed sert les .webm en text/plain : les
# navigateurs de bureau s'en sortent en analysant le contenu du fichier,
# mais Safari est plus strict et peut refuser de lire la video.
# Les .webp et .ico sont deja corrects cote serveur, on les fixe ici par
# securite (une redeclaration identique est sans effet de bord).

AddType video/webm  .webm
AddType video/mp4   .mp4
AddType image/webp  .webp

# -------------------------------------------------------
# Page 404 custom
# -------------------------------------------------------
ErrorDocument 404 /404.html
